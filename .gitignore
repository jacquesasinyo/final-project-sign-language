# ============================================
# TİD Engineering Project I
# Initial .gitignore
# ============================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- Jupyter ---
.ipynb_checkpoints/

# --- Dataset files ---
# Keep dataset metadata/configuration in Git, but not the actual videos/data.
data/raw/
data/external/
data/downloads/

# --- Extracted / cached features ---
data/processed/
data/cache/
cache/
features/
landmarks/

# --- Training outputs ---
outputs/
runs/
logs/
checkpoints/
artifacts/

# --- Trained model files ---
*.h5
*.keras
*.pt
*.pth
*.ckpt
*.onnx
*.tflite

# --- TensorBoard / experiment trackers ---
tensorboard/
events.out.tfevents.*
wandb/
mlruns/

# --- Logs / temporary files ---
*.log
tmp/
temp/
*.tmp

# --- Archives ---
*.zip
*.tar
*.tar.gz
*.7z

# ============================================
# Intentionally tracked
# ============================================
# configs/
# docs/
# src/
# scripts/
# tests/
# README.md
# PROJECT_REQUIREMENTS.md
# CLAUDE.md
# requirements.txt / pyproject.toml
#
# For tiny test fixtures, use a tracked folder such as:
# tests/fixtures/

# --- Generated by `pip install -e .` ---
*.egg-info/

# --- Previous TÜBİTAK work (2.1 GB incl. recorded .npy data; read-only, DS-05) ---
isolated sign language/
